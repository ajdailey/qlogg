<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.ajdailey.qlogg</groupId>
    <artifactId>qlogg-parent</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>

    <name>QLogg</name>
    <description>Cross-platform log viewer</description>

    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <modules>
        <module>qlogg-bootstrap</module>
        <module>qlogg-core</module>
        <module>qlogg-app</module>
        <module>qlogg-ui-swt</module>
        <module>qlogg-launcher</module>
        <module>qlogg-dist</module>
        <module>qlogg-bench</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.release>21</maven.compiler.release>

        <!-- ===== Plugin versions (alphabetical). Newest stable; milestones
             and 4.0.0 betas are not targets. ===== -->
        <build-helper-maven-plugin.version>3.6.2</build-helper-maven-plugin.version>
        <checkstyle.version>14.4.0</checkstyle.version>
        <exec-maven-plugin.version>3.6.4</exec-maven-plugin.version>
        <findsecbugs.version>1.14.0</findsecbugs.version>
        <!-- 1.37.0 fails inside spotless-maven-plugin 3.10.4 (InvocationTargetException
             on every file) while it formats correctly standalone. -->
        <google-java-format.version>1.36.1</google-java-format.version>
        <launch4j-maven-plugin.version>2.7.0</launch4j-maven-plugin.version>
        <maven-antrun-plugin.version>3.2.0</maven-antrun-plugin.version>
        <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
        <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
        <maven-deploy-plugin.version>3.2.0</maven-deploy-plugin.version>
        <maven-enforcer-plugin.version>3.7.0</maven-enforcer-plugin.version>
        <maven-install-plugin.version>3.2.0</maven-install-plugin.version>
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
        <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
        <maven-shade-plugin.version>3.6.2</maven-shade-plugin.version>
        <maven-site-plugin.version>3.22.0</maven-site-plugin.version>
        <maven-surefire-plugin.version>3.6.1</maven-surefire-plugin.version>
        <spotbugs.version>4.10.5</spotbugs.version>
        <spotbugs-maven-plugin.version>4.10.5.0</spotbugs-maven-plugin.version>
        <spotless-maven-plugin.version>3.10.4</spotless-maven-plugin.version>

        <!-- ===== Libraries (alphabetical) ===== -->
        <archunit.version>1.5.1</archunit.version>
        <!-- Build only: converts docs/user-guide.md to the in-jar guide; not shipped. -->
        <commonmark.version>0.32.0</commonmark.version>
        <!-- Benchmarks only (qlogg-bench); not shipped. -->
        <jmh.version>1.37</jmh.version>
        <!-- Build only: renders the qlogg-ui-swt SVG icons to PNG; not shipped. -->
        <jsvg.version>2.2.0</jsvg.version>
        <junit-bom.version>6.1.3</junit-bom.version>
        <!-- logback-classic 1.6.6 is built against slf4j-api 2.0.19; 2.1.0-alpha1
             is a pre-release. -->
        <logback.version>1.6.6</logback.version>
        <slf4j.version>2.0.20</slf4j.version>
        <swt.version>3.135.0</swt.version>

        <!-- JUnit tags surefire skips; the no-display profile adds swt. -->
        <qlogg.excludedGroups></qlogg.excludedGroups>
        <!-- Extra test JVM options; the macos profile sets them. -->
        <qlogg.test.jvmArgs></qlogg.test.jvmArgs>
        <qlogg.config.dir>${maven.multiModuleProjectDirectory}/config</qlogg.config.dir>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>io.github.ajdailey.qlogg</groupId>
                <artifactId>qlogg-bootstrap</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.ajdailey.qlogg</groupId>
                <artifactId>qlogg-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.ajdailey.qlogg</groupId>
                <artifactId>qlogg-core</artifactId>
                <version>${project.version}</version>
                <type>test-jar</type>
            </dependency>
            <dependency>
                <groupId>io.github.ajdailey.qlogg</groupId>
                <artifactId>qlogg-app</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.ajdailey.qlogg</groupId>
                <artifactId>qlogg-ui-swt</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.ajdailey.qlogg</groupId>
                <artifactId>qlogg-launcher</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-classic</artifactId>
                <version>${logback.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-core</artifactId>
                <version>${logback.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit</artifactId>
                <version>${archunit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-core</artifactId>
                <version>${jmh.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-generator-annprocess</artifactId>
                <version>${jmh.version}</version>
            </dependency>

            <!-- SWT fragments. Each fragment POM depends back on the
                 org.eclipse.swt host POM, whose OS-activated profiles add the
                 build host's fragment; the exclusion keeps one SWT
                 implementation on a class path. -->
            <dependency>
                <groupId>org.eclipse.platform</groupId>
                <artifactId>org.eclipse.swt.gtk.linux.x86_64</artifactId>
                <version>${swt.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>org.eclipse.platform</groupId>
                        <artifactId>org.eclipse.swt</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>org.eclipse.platform</groupId>
                <artifactId>org.eclipse.swt.gtk.linux.aarch64</artifactId>
                <version>${swt.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>org.eclipse.platform</groupId>
                        <artifactId>org.eclipse.swt</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>org.eclipse.platform</groupId>
                <artifactId>org.eclipse.swt.win32.win32.x86_64</artifactId>
                <version>${swt.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>org.eclipse.platform</groupId>
                        <artifactId>org.eclipse.swt</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>org.eclipse.platform</groupId>
                <artifactId>org.eclipse.swt.win32.win32.aarch64</artifactId>
                <version>${swt.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>org.eclipse.platform</groupId>
                        <artifactId>org.eclipse.swt</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>org.eclipse.platform</groupId>
                <artifactId>org.eclipse.swt.cocoa.macosx.x86_64</artifactId>
                <version>${swt.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>org.eclipse.platform</groupId>
                        <artifactId>org.eclipse.swt</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>org.eclipse.platform</groupId>
                <artifactId>org.eclipse.swt.cocoa.macosx.aarch64</artifactId>
                <version>${swt.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>org.eclipse.platform</groupId>
                        <artifactId>org.eclipse.swt</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Every plugin is pinned, including the ones Maven binds by
                     default, so every host resolves the same versions. -->
                <plugin>
                    <groupId>com.akathist.maven.plugins.launch4j</groupId>
                    <artifactId>launch4j-maven-plugin</artifactId>
                    <version>${launch4j-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>com.github.spotbugs</groupId>
                    <artifactId>spotbugs-maven-plugin</artifactId>
                    <version>${spotbugs-maven-plugin.version}</version>
                    <dependencies>
                        <dependency>
                            <groupId>com.github.spotbugs</groupId>
                            <artifactId>spotbugs</artifactId>
                            <version>${spotbugs.version}</version>
                        </dependency>
                    </dependencies>
                    <configuration>
                        <effort>Max</effort>
                        <threshold>Low</threshold>
                        <failOnError>true</failOnError>
                        <excludeFilterFile>${qlogg.config.dir}/spotbugs-exclude.xml</excludeFilterFile>
                        <!-- Registers LogText.oneLine as removing CR and LF, so a
                             log call that neutralizes its argument is not reported
                             as CRLF_INJECTION_LOGS. -->
                        <systemPropertyVariables>
                            <findsecbugs.taint.customconfigfile>${qlogg.config.dir}/findsecbugs-taint.txt</findsecbugs.taint.customconfigfile>
                        </systemPropertyVariables>
                        <plugins>
                            <plugin>
                                <groupId>com.h3xstream.findsecbugs</groupId>
                                <artifactId>findsecbugs-plugin</artifactId>
                                <version>${findsecbugs.version}</version>
                            </plugin>
                        </plugins>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${spotless-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-antrun-plugin</artifactId>
                    <version>${maven-antrun-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-checkstyle-plugin</artifactId>
                    <version>${maven-checkstyle-plugin.version}</version>
                    <dependencies>
                        <dependency>
                            <groupId>com.puppycrawl.tools</groupId>
                            <artifactId>checkstyle</artifactId>
                            <version>${checkstyle.version}</version>
                        </dependency>
                    </dependencies>
                    <configuration>
                        <configLocation>${qlogg.config.dir}/checkstyle.xml</configLocation>
                        <includeTestSourceDirectory>true</includeTestSourceDirectory>
                        <consoleOutput>true</consoleOutput>
                        <failOnViolation>true</failOnViolation>
                        <violationSeverity>warning</violationSeverity>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>${maven-clean-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <encoding>${project.build.sourceEncoding}</encoding>
                        <compilerArgs>
                            <arg>-Xlint:all,-processing,-options</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>${maven-dependency-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>${maven-deploy-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven-enforcer-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>${maven-install-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                    <configuration>
                        <archive>
                            <manifest>
                                <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                            </manifest>
                        </archive>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven-resources-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>${maven-shade-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-site-plugin</artifactId>
                    <version>${maven-site-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <configuration>
                        <excludedGroups>${qlogg.excludedGroups}</excludedGroups>
                        <!-- SWT writes ~/.swt/trims.prefs; keep it out of the
                             user's home. -->
                        <argLine>-Duser.home=${project.build.directory}/test-home ${qlogg.test.jvmArgs}</argLine>
                        <!-- GTK prefers Wayland when WAYLAND_DISPLAY is set, which
                             puts test windows on the desktop session instead of
                             the X server DISPLAY names (Xvfb). -->
                        <environmentVariables>
                            <GDK_BACKEND>x11</GDK_BACKEND>
                        </environmentVariables>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>build-helper-maven-plugin</artifactId>
                    <version>${build-helper-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>${exec-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                                <!-- logback-classic declares janino as optional;
                                     it evaluates logback configuration conditions. -->
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>org.codehaus.janino:*</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Formatting check; fix with ./mvnw spotless:apply. -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <configuration>
                    <lineEndings>GIT_ATTRIBUTES</lineEndings>
                    <java>
                        <includes>
                            <include>src/main/java/**/*.java</include>
                            <include>src/test/java/**/*.java</include>
                        </includes>
                        <removeUnusedImports/>
                        <googleJavaFormat>
                            <version>${google-java-format.version}</version>
                            <style>GOOGLE</style>
                        </googleJavaFormat>
                    </java>
                    <formats>
                        <format>
                            <includes>
                                <include>pom.xml</include>
                                <include>*.md</include>
                                <include>src/**/*.xml</include>
                                <include>src/**/*.properties</include>
                                <include>src/**/*.cfg</include>
                                <include>src/**/*.plist</include>
                                <include>src/**/*.txt</include>
                                <include>src/**/*.entitlements</include>
                                <include>config/*.xml</include>
                                <include>config/*.txt</include>
                                <include>docker/Dockerfile</include>
                                <include>compose.yaml</include>
                                <include>.github/workflows/*.yml</include>
                                <include>.editorconfig</include>
                                <include>.gitattributes</include>
                                <include>.gitignore</include>
                            </includes>
                            <excludes>
                                <exclude>src/test/resources/**</exclude>
                            </excludes>
                            <trimTrailingWhitespace/>
                            <endWithNewline/>
                        </format>
                        <!-- No trailing-whitespace trim in scripts: it can be
                             significant in a heredoc. -->
                        <format>
                            <includes>
                                <include>src/bin/*</include>
                                <include>tools/*.sh</include>
                                <include>scripts/*.sh</include>
                                <include>scripts/*.bat</include>
                                <include>.github/scripts/*</include>
                            </includes>
                            <endWithNewline/>
                        </format>
                    </formats>
                </configuration>
                <executions>
                    <execution>
                        <id>spotless-check</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <executions>
                    <execution>
                        <id>checkstyle</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>spotbugs</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- On Linux without DISPLAY SWT cannot create a Display, so SWT tests
             are skipped; run them under a display or xvfb-run. Windows and
             macOS always run them. -->
        <profile>
            <id>no-display</id>
            <activation>
                <os>
                    <name>Linux</name>
                </os>
                <property>
                    <name>!env.DISPLAY</name>
                </property>
            </activation>
            <properties>
                <qlogg.excludedGroups>swt</qlogg.excludedGroups>
            </properties>
        </profile>
        <!-- SWT on macOS needs the Display on the first thread; surefire runs
             tests on the forked JVM's main thread. -->
        <profile>
            <id>macos</id>
            <activation>
                <os>
                    <family>mac</family>
                </os>
            </activation>
            <properties>
                <qlogg.test.jvmArgs>-XstartOnFirstThread</qlogg.test.jvmArgs>
            </properties>
        </profile>

        <!-- Fragment selection. A host profile applies when qlogg.target is
             absent; an explicit profile applies for -Dqlogg.target=<target>.
             A property set inside a profile does not activate another
             profile, so each host profile sets every target property itself.
             qlogg-ui-swt and qlogg-launcher compile and test against
             swt.fragment; qlogg-dist builds the bundle for qlogg.target.name.
             An explicit target skips the SWT tests, which need the host's
             fragment. -->
        <profile>
            <id>host-linux-x86_64</id>
            <activation>
                <os><name>Linux</name><arch>amd64</arch></os>
                <property><name>!qlogg.target</name></property>
            </activation>
            <properties>
                <swt.fragment>gtk.linux.x86_64</swt.fragment>
                <qlogg.target.name>linux-x86_64</qlogg.target.name>
            </properties>
        </profile>
        <profile>
            <id>host-linux-aarch64</id>
            <activation>
                <os><name>Linux</name><arch>aarch64</arch></os>
                <property><name>!qlogg.target</name></property>
            </activation>
            <properties>
                <swt.fragment>gtk.linux.aarch64</swt.fragment>
                <qlogg.target.name>linux-aarch64</qlogg.target.name>
            </properties>
        </profile>
        <profile>
            <id>host-windows-x86_64</id>
            <activation>
                <os><family>windows</family><arch>amd64</arch></os>
                <property><name>!qlogg.target</name></property>
            </activation>
            <properties>
                <swt.fragment>win32.win32.x86_64</swt.fragment>
                <qlogg.target.name>windows-x86_64</qlogg.target.name>
            </properties>
        </profile>
        <profile>
            <id>host-windows-aarch64</id>
            <activation>
                <os><family>windows</family><arch>aarch64</arch></os>
                <property><name>!qlogg.target</name></property>
            </activation>
            <properties>
                <swt.fragment>win32.win32.aarch64</swt.fragment>
                <qlogg.target.name>windows-aarch64</qlogg.target.name>
            </properties>
        </profile>
        <profile>
            <id>host-macos-x86_64</id>
            <activation>
                <os><family>mac</family><arch>x86_64</arch></os>
                <property><name>!qlogg.target</name></property>
            </activation>
            <properties>
                <swt.fragment>cocoa.macosx.x86_64</swt.fragment>
                <qlogg.target.name>macos-x86_64</qlogg.target.name>
            </properties>
        </profile>
        <profile>
            <id>host-macos-aarch64</id>
            <activation>
                <os><family>mac</family><arch>aarch64</arch></os>
                <property><name>!qlogg.target</name></property>
            </activation>
            <properties>
                <swt.fragment>cocoa.macosx.aarch64</swt.fragment>
                <qlogg.target.name>macos-aarch64</qlogg.target.name>
            </properties>
        </profile>

        <profile>
            <id>linux-x86_64</id>
            <activation>
                <property><name>qlogg.target</name><value>linux-x86_64</value></property>
            </activation>
            <properties>
                <swt.fragment>gtk.linux.x86_64</swt.fragment>
                <qlogg.target.name>linux-x86_64</qlogg.target.name>
                <qlogg.excludedGroups>swt</qlogg.excludedGroups>
            </properties>
        </profile>
        <profile>
            <id>linux-aarch64</id>
            <activation>
                <property><name>qlogg.target</name><value>linux-aarch64</value></property>
            </activation>
            <properties>
                <swt.fragment>gtk.linux.aarch64</swt.fragment>
                <qlogg.target.name>linux-aarch64</qlogg.target.name>
                <qlogg.excludedGroups>swt</qlogg.excludedGroups>
            </properties>
        </profile>
        <profile>
            <id>windows-x86_64</id>
            <activation>
                <property><name>qlogg.target</name><value>windows-x86_64</value></property>
            </activation>
            <properties>
                <swt.fragment>win32.win32.x86_64</swt.fragment>
                <qlogg.target.name>windows-x86_64</qlogg.target.name>
                <qlogg.excludedGroups>swt</qlogg.excludedGroups>
            </properties>
        </profile>
        <profile>
