<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.ajdailey.qlogg</groupId>
        <artifactId>qlogg-parent</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>qlogg-app</artifactId>
    <name>QLogg application</name>

    <dependencies>
        <dependency>
            <groupId>io.github.ajdailey.qlogg</groupId>
            <artifactId>qlogg-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.ajdailey.qlogg</groupId>
            <artifactId>qlogg-core</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Tests that check a log statement capture it with a JUL Handler. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-jdk14</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- Help > About > Licenses reads the notices from the jar. -->
            <resource>
                <directory>${project.basedir}/..</directory>
                <includes>
                    <include>LICENSE</include>
                    <include>NOTICE</include>
                </includes>
                <targetPath>io/github/ajdailey/qlogg/app/about</targetPath>
            </resource>
            <resource>
                <directory>${project.basedir}/../qlogg-dist/src/dist</directory>
                <includes>
                    <include>THIRD-PARTY.txt</include>
                </includes>
                <targetPath>io/github/ajdailey/qlogg/app/about</targetPath>
            </resource>
        </resources>
        <plugins>
            <!-- docs/user-guide.md converts to one self-contained HTML page under
                 target/generated-resources/guide, which the jar includes. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>guide-renderer</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.commonmark</groupId>
                                    <artifactId>commonmark</artifactId>
                                    <version>${commonmark.version}</version>
                                    <destFileName>commonmark.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.commonmark</groupId>
                                    <artifactId>commonmark-ext-gfm-tables</artifactId>
                                    <version>${commonmark.version}</version>
                                    <destFileName>commonmark-tables.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>${project.build.directory}/guide-tools</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>render-guide</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <arguments>
                                <argument>-cp</argument>
                                <argument>${project.build.directory}/guide-tools/commonmark.jar${path.separator}${project.build.directory}/guide-tools/commonmark-tables.jar</argument>
                                <argument>${project.basedir}/src/build/GuideRenderer.java</argument>
                                <argument>${project.basedir}/../docs/user-guide.md</argument>
                                <argument>${project.build.directory}/generated-resources/guide/io/github/ajdailey/qlogg/app/guide/guide.html</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>guide-resources</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>add-resource</goal>
                        </goals>
                        <configuration>
                            <resources>
                                <resource>
                                    <directory>${project.build.directory}/generated-resources/guide</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- ManualUiDispatcher is shared with the UI and launcher tests. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>test-jar</id>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Logging off in tests; a test that checks a statement attaches its own
                 Handler and sets that logger's level. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-Duser.home=${project.build.directory}/test-home ${qlogg.test.jvmArgs} -Djava.util.logging.config.file=${project.basedir}/src/test/resources/quiet-logging.properties</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
