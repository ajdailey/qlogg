<?xml version="1.0" encoding="UTF-8"?>
<!-- Each suppression names the class, the pattern and the reason. -->
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/3.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.0.1/spotbugs/etc/findbugsfilter.xsd">

  <!-- The macOS relaunch runs this JVM's own binary with a fixed argument
       list; the original arguments are separate list elements and no shell
       parses them. -->
  <Match>
    <Class name="io.github.ajdailey.qlogg.bootstrap.MacRelaunch"/>
    <Bug pattern="COMMAND_INJECTION"/>
  </Match>

  <!-- Natives cache: library names come from the build-time index, match
       [A-Za-z0-9._-]+ and are checked to resolve inside the directory; the
       directory comes from the settings option, qlogg.home or the per-user cache, and
       is created owner-only. -->
  <Match>
    <Or>
      <Class name="io.github.ajdailey.qlogg.bootstrap.Boot"/>
      <Class name="io.github.ajdailey.qlogg.bootstrap.BootIndex"/>
      <Class name="io.github.ajdailey.qlogg.bootstrap.Natives"/>
      <Class name="io.github.ajdailey.qlogg.bootstrap.NativesLocation"/>
    </Or>
    <Bug pattern="PATH_TRAVERSAL_IN"/>
  </Match>

  <!-- The bootstrap invokes the launcher's main reflectively and rethrows
       whatever exception it ends with. -->
  <Match>
    <Or>
      <Class name="io.github.ajdailey.qlogg.bootstrap.Boot"/>
      <Class name="io.github.ajdailey.qlogg.bootstrap.Main"/>
    </Or>
    <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION"/>
  </Match>
  <!-- Controllers and views keep the collaborators they are constructed
       with; sharing them is the design, not a leak of internal state. -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
  <!-- Line index writer state: one indexing operation at a time owns it,
       handed over through the index's AtomicBoolean; readers see only the
       volatile published snapshot. The indexing and search operations' own
       fields are used by their coordinator thread only. -->
  <Match>
    <Or>
      <Class name="io.github.ajdailey.qlogg.core.index.GrowableLineIndex"/>
      <Class name="io.github.ajdailey.qlogg.core.index.Indexer$Operation"/>
      <Class name="io.github.ajdailey.qlogg.core.search.SearchEngine$Operation"/>
    </Or>
    <Bug pattern="AT_NONATOMIC_64BIT_PRIMITIVE,AT_NONATOMIC_OPERATIONS_ON_SHARED_VARIABLE,AT_STALE_THREAD_WRITE_OF_PRIMITIVE"/>
  </Match>
  <!-- Controller and view state is confined to the UI thread. A worker
       touches it only inside a runnable posted through UiDispatcher.asyncExec,
       which runs on the UI thread after the Display's queue hands it over. -->
  <Match>
    <Or>
      <Package name="io.github.ajdailey.qlogg.app.controller"/>
      <Package name="io.github.ajdailey.qlogg.ui.swt"/>
      <Class name="io.github.ajdailey.qlogg.app.view.UiUpdateQueue"/>
    </Or>
    <Bug pattern="AT_NONATOMIC_64BIT_PRIMITIVE,AT_NONATOMIC_OPERATIONS_ON_SHARED_VARIABLE,AT_STALE_THREAD_WRITE_OF_PRIMITIVE"/>
  </Match>
  <!-- The uncaught-exception handler logs the throwable as the throwable
       argument; its stack trace is multi-line by design and its thread name
       passes through LogText.oneLine. -->
  <Match>
    <Class name="io.github.ajdailey.qlogg.launcher.Launcher$FailureLogger"/>
    <Bug pattern="CRLF_INJECTION_LOGS"/>
  </Match>
</FindBugsFilter>
